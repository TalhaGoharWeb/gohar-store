# =============================================================================
# GOHAR Store — backend environment template (Milestone 2)
# =============================================================================
# Copy to .env and fill in real values. NEVER commit a real .env, and
# NEVER put a real secret in this file.
#
# Two ways to run (see ~/workspace/gohar-store/README.md and infra/README.md):
#   1. Docker (recommended): `docker compose -f infra/docker-compose.yml up`
#      — the compose file overrides DB_HOST/REDIS_HOST/MAIL_HOST with the
#      service names (pgsql / redis / mailpit) via infra/.env.
#   2. Native PHP on your machine: install PHP 8.3 + extensions
#      (see backend/M2-BACKEND-REPORT.md), run Postgres + Redis locally,
#      and use the 127.0.0.1 hosts below.
#
# APP_URL is a PLACEHOLDER until the real domain is confirmed
# (docs/02-database-api.md §E uses https://api.gohar.store as a placeholder).
# =============================================================================

APP_NAME="GOHAR Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.gohar.store

GOHAR_VERSION=0.2.0-dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: PostgreSQL 16 (dev default). Tests use sqlite :memory:. ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gohar_store
DB_USERNAME=gohar
DB_PASSWORD=gohar_dev_only_change_me

# --- Sessions: database-backed (maps to the user_sessions design, §C). ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Cache / queues: Redis 7. The php-redis extension is used
# (REDIS_CLIENT=phpredis); no predis package is required. ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Files: local disk in M2. Private object storage (R2 / MinIO) lands
# in M5 (quarantine uploads) / M7 (signed downloads). ---
FILESYSTEM_DISK=local

# --- Mail: Mailpit in Docker (http://localhost:8025), log driver natively.
# Production mail provider is an M10 decision — no provider is assumed. ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gohar.store"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum: stateful (cookie) domains for the web portal / Filament.
# The Android app uses per-device API tokens, not cookies. ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080

# --- Object storage (NOT USED in M2 — placeholders for M5/M7). ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=gohar-store-private
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
