<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GoharStore" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Material 3 roles — dark theme (Phase 2 §2.6, C-01).
             The @color/<role> references resolve to the values-night
             values; the same theme items exist in values/themes.xml. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorOnTertiary">@color/colorOnTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/colorOnTertiaryContainer</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/colorSurfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/colorSurfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/colorSurfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/colorSurfaceContainerHighest</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnErrorContainer</item>
        <item name="colorPrimaryDark">@color/gohar_navy_dark</item>
        <item name="toolbarStyle">@style/Widget.GoharStore.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.GoharStore.Dialog</item>
        <!-- Status bar is always navy with light icons, both themes
             (Phase 2 D4). -->
        <item name="android:statusBarColor">@color/gohar_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Nav bar matches the theme background; light nav icons in dark. -->
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_navigation_bar</item>
    </style>

    <style name="Widget.GoharStore.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/toolbar_background</item>
        <item name="titleTextColor">@color/toolbar_title</item>
        <item name="subtitleTextColor">@color/toolbar_subtitle</item>
    </style>

    <!-- Default TextView style (plain). The Urdu locale overrides
         this same style with the Jameel Noori Nastaleeq font; it must exist
         here or AAPT fails the ur-only reference. -->
    <style name="Widget.GoharStore.TextView" parent="android:Widget.TextView" />

    <!-- Default toolbar title appearance (plain). The Urdu locale
         overrides this same style with a smaller title size. -->
    <style name="Widget.GoharStore.Toolbar.TitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title" />

    <!-- AlertDialog theme (C-31, dark): same English text appearances as
         the light theme; the Urdu locale resolves its own overlay. -->
    <style name="ThemeOverlay.GoharStore.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.GoharStore.TitleL</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.GoharStore.BodyM</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.GoharStore.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.GoharStore.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.GoharStore.DialogButton</item>
    </style>

    <style name="Widget.GoharStore.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAppearance">@style/TextAppearance.GoharStore.LabelL</item>
    </style>
</resources>
