<?xml version="1.0" encoding="utf-8"?>
<!-- Side-drawer menu (v1.3.11): the same actions the three-dot
     overflow menu used to hold, now in the hamburger drawer.
     Item ids are unchanged, so MainActivity's handling moved over
     as-is. Language items sit in their own group, separated by a
     divider, and carry no icon — they are secondary. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <group android:id="@+id/group_main">
        <!-- No owner entry points here (owner decision 28 Nov ~03:17
             PKT): "Developer Console" and "Owner sign-in" were
             removed from this menu. The owner reaches sign-in /
             console only via 5 taps on the version in the drawer
             header (MainActivity.onVersionTap). "Sign out" stays,
             visible only while signed in (MainActivity). -->
        <item
            android:id="@+id/owner_sign_out"
            android:icon="@drawable/ic_logout"
            android:title="@string/sign_out" />
        <item
            android:id="@+id/show_featured"
            android:icon="@drawable/ic_star"
            android:title="@string/show_featured" />
        <item
            android:id="@+id/about_author"
            android:icon="@drawable/ic_info"
            android:title="@string/about_author" />
    </group>
    <group android:id="@+id/group_theme"
        android:checkableBehavior="single">
        <item
            android:id="@+id/theme_dark"
            android:title="@string/theme_dark" />
        <item
            android:id="@+id/theme_light"
            android:title="@string/theme_light" />
        <item
            android:id="@+id/theme_system"
            android:title="@string/theme_system" />
    </group>
    <group android:id="@+id/group_language">
        <item
            android:id="@+id/language_urdu"
            android:title="@string/language_urdu" />
        <item
            android:id="@+id/language_english"
            android:title="@string/language_english" />
    </group>
</menu>
