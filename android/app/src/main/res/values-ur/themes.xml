<?xml version="1.0" encoding="utf-8"?>
<!-- Urdu locale theme: identical to res/values/themes.xml (a
     locale-qualified style replaces the base one entirely, so every
     item is repeated), plus Noto Naskh Arabic as the app font and
     extra line spacing — Urdu's tall letters need breathing room.
     The default (values/) theme is untouched, so Latin UI is unchanged. -->
<resources>
    <style name="Theme.GoharStore" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gohar_navy</item>
        <item name="colorPrimaryDark">@color/gohar_navy_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/gohar_teal</item>
        <item name="colorSecondaryContainer">#D6F2F1</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="toolbarStyle">@style/Widget.GoharStore.Toolbar</item>
        <item name="android:fontFamily">@font/urdu</item>
        <item name="android:textViewStyle">@style/Widget.GoharStore.TextView</item>
    </style>

    <style name="Widget.GoharStore.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/urdu</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>
