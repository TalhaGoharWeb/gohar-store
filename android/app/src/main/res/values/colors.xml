<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 roles — LIGHT theme (Phase 2 §2.6, C-02 values).
         The same resource names are defined in values-night/colors.xml
         with the dark values, so themes reference @color/<role> and the
         DayNight parent resolves the right value per theme. -->
    <color name="colorPrimary">#3267E8</color>
    <color name="colorOnPrimary">#FFFFFF</color>
    <color name="colorPrimaryContainer">#DCE6FF</color>
    <color name="colorOnPrimaryContainer">#1E3A8A</color>
    <color name="colorSecondary">#17D6B5</color>
    <color name="colorOnSecondary">#06152F</color>
    <color name="colorSecondaryContainer">#C9F5EA</color>
    <color name="colorOnSecondaryContainer">#0A6E6D</color>
    <color name="colorTertiary">#E7B84F</color>
    <color name="colorOnTertiary">#06152F</color>
    <color name="colorTertiaryContainer">#F7ECD2</color>
    <color name="colorOnTertiaryContainer">#8C6D1F</color>
    <color name="colorSurface">#FFFFFF</color>
    <color name="colorOnSurface">#0B2450</color>
    <color name="colorSurfaceVariant">#F0EEE9</color>
    <color name="colorOnSurfaceVariant">#5A6B84</color>
    <color name="colorSurfaceContainerLowest">#FFFFFF</color>
    <color name="colorSurfaceContainerLow">#F8F6F1</color>
    <color name="colorSurfaceContainer">#F0EEE9</color>
    <color name="colorSurfaceContainerHigh">#E7E5DE</color>
    <color name="colorSurfaceContainerHighest">#DCD9D1</color>
    <color name="colorBackground">#F8F6F1</color>
    <color name="colorOnBackground">#0B2450</color>
    <color name="colorOutline">#D8DDE6</color>
    <color name="colorOutlineVariant">#E7E5DE</color>
    <color name="colorError">#B3261E</color>
    <color name="colorOnError">#FFFFFF</color>
    <color name="colorErrorContainer">#F9DEDC</color>
    <color name="colorOnErrorContainer">#410E0B</color>

    <!-- Legacy gohar_* names, redefined in place per I-4.0.1 (light values).
         They stay because 55 references exist across layouts, themes,
         drawables and launcher XMLs; redefinition makes them theme-aware. -->
    <color name="gohar_navy">#0B2450</color>
    <color name="gohar_navy_dark">#06152F</color>
    <color name="gohar_teal">#0E9594</color>
    <color name="gohar_teal_dark">#0A6E6D</color>
    <color name="gohar_gold">#E7B84F</color>
    <!-- gohar_cream is referenced NOWHERE (verified by grep over res/ and
         java/ at implementation time) — left at its old value as-is per
         the task; it is not defined in values-night either. -->
    <color name="gohar_cream">#F5F1E6</color>
    <color name="gohar_icon_bg">#06152F</color>
    <color name="gohar_background">#F8F6F1</color>
    <color name="gohar_card">#FFFFFF</color>
    <color name="gohar_text">#0B2450</color>
    <color name="gohar_text_secondary">#5A6B84</color>
    <!-- Soft teal tint for a selected drawer item (v1.3.11). -->
    <color name="drawer_item_selected">#D6F2F1</color>

    <!-- Disabled text (Phase 2 §2.5 R7): light #9AA5B5, dark #5A6B84. -->
    <color name="text_disabled">#9AA5B5</color>

    <!-- Shared role colours per I-4.0.11 (light values). -->
    <color name="toolbar_background">#FFFFFF</color>
    <color name="toolbar_title">#0B2450</color>
    <color name="toolbar_subtitle">#5A6B84</color>
    <color name="drawer_icon_tint">#0E9594</color>
    <color name="badge_fill">#DCE6FF</color>
    <color name="badge_text">#1E3A8A</color>
    <color name="uninstall_red">#B3261E</color>
    <!-- Dialog action-button colours (C-43 / D-5.1): confirm is the success
         text colour in light (#0A6E6D, 6.06:1 — Turquoise as text is 1.85:1
         and never used); destructive is the error colour. -->
    <color name="dialog_confirm">#0A6E6D</color>
    <color name="dialog_destructive">#B3261E</color>

    <!-- Theme-dependent boolean: the values-ur theme replaces the base
         theme entirely, so it cannot hardcode windowLightNavigationBar
         (true in light, false in dark). It references this bool instead;
         values-night/colors.xml defines it as false. -->
    <bool name="window_light_navigation_bar">true</bool>
</resources>
