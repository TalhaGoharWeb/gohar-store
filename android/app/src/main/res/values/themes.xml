<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GoharStore" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gohar_navy</item>
        <item name="colorPrimaryDark">@color/gohar_navy_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/gohar_teal</item>
        <item name="colorSecondaryContainer">#D6F2F1</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="toolbarStyle">@style/Widget.GoharStore.Toolbar</item>
    </style>

    <!-- Launch splash for MainActivity (see AndroidManifest). The splash
         is only the window background, so it shows instantly while the
         app starts and costs no extra time. MainActivity switches back
         to Theme.GoharStore in onCreate, before super.onCreate().
         The API 31+ windowSplashScreen* items were removed in v1.3.5:
         they are the only new native launch code in v1.3.4 and the app
         crashed right after the splash on the phone, so the splash is
         back to the plain windowBackground only. -->
    <style name="Theme.GoharStore.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Widget.GoharStore.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/gohar_navy</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="subtitleTextColor">#C7D6E8</item>
    </style>

    <!-- Default TextView style (plain). The Urdu locale overrides
         this same style with the Noto Nastaliq Urdu font; it must exist
         here or AAPT fails the ur-only reference. -->
    <style name="Widget.GoharStore.TextView" parent="android:Widget.TextView" />

    <!-- Default toolbar title appearance (plain). The Urdu locale
         overrides this same style with a smaller title size. -->
    <style name="Widget.GoharStore.Toolbar.TitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title" />
</resources>
