<?xml version="1.0" encoding="utf-8"?>
<!-- Wide-screen (>=600dp) app card: the list becomes a 2-column grid
     (span count in MainActivity), so the row layout would squeeze the
     name into ~70dp. This variant keeps every id the adapter uses
     (bindRow is unchanged) but stacks vertically: icon + name on top,
     full-width action button below. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/app_card_margin"
    android:layout_marginTop="@dimen/app_card_margin_top"
    android:layout_marginEnd="@dimen/app_card_margin"
    app:cardCornerRadius="@dimen/radius_l"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Real icon on top of the gradient letter tile (the tile is
                 the fallback while the icon loads, or when it has none). -->
            <FrameLayout
                android:layout_width="@dimen/app_row_icon_size"
                android:layout_height="@dimen/app_row_icon_size">

                <TextView
                    android:id="@+id/appIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/radius_l"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/appIconImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GoharStore.TitleS" />

                <TextView
                    android:id="@+id/appDeveloper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.GoharStore.BodyS"
                    />

                <TextView
                    android:id="@+id/appMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textAppearance="@style/TextAppearance.GoharStore.BodyS"
                    />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/install"
                android:textAppearance="@style/TextAppearance.GoharStore.LabelL"
                android:textColor="@color/btn_primary_text"
                app:backgroundTint="@color/btn_primary_fill"
                app:cornerRadius="@dimen/radius_full" />

            <TextView
                android:id="@+id/updateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_background"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/update_badge"
                android:textColor="@color/badge_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/downloadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:max="100"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressTint="@color/gohar_teal"
            android:visibility="gone" />

        <!-- Pause / Resume / Cancel — only while a download is active
             or paused. -->
        <LinearLayout
            android:id="@+id/downloadControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadPauseButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/hero_button_height"
                android:text="@string/pause_download"
                android:textAppearance="@style/TextAppearance.GoharStore.LabelL" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadCancelButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/hero_button_height"
                android:text="@string/cancel_download"
                android:textAppearance="@style/TextAppearance.GoharStore.LabelL" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
