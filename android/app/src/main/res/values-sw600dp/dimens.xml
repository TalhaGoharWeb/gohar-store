<?xml version="1.0" encoding="utf-8"?>
<!-- Wide screens (>=600dp: tablets, landscape phones). The list
     switches to a 2-column grid (span count is computed from the
     content width in MainActivity), the outer margins grow, and the
     app cards tighten so the grid gutter stays 16dp. The 360dp phone
     never sees these values. -->
<resources>
    <dimen name="content_margin">24dp</dimen>
    <dimen name="section_title_size">20sp</dimen>
    <dimen name="app_card_margin">8dp</dimen>
    <dimen name="app_card_margin_top">8dp</dimen>
    <dimen name="chip_row_padding">20dp</dimen>
    <dimen name="app_row_icon_size">80dp</dimen>
    <dimen name="hero_button_height">48dp</dimen>
</resources>
