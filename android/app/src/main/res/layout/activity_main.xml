<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a DrawerLayout (v1.3.11): the hamburger opens the side
     drawer (NavigationView at the end of this file); the old
     three-dot overflow menu is gone. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/gohar_navy"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:title="">

            <!-- One row (v1.3.13): hamburger + title + full banner,
                 all vertically centred, app bar 72dp. The banner is
                 NOT cropped (v1.3.12's centreCrop cut the side
                 decorations): full 935x351 art at 58dp tall = 154dp
                 wide. It only fits because the hamburger is the
                 app's own 40dp button (the stock Toolbar navigation
                 button is 56dp) and the margins are tight.
                 Measured at 360dp: hamburger 40 + title margin 8 +
                 title (EN 139dp measured in Noto Sans Bold, UR
                 ~49dp) + banner 154 + end margin 8 = ~349dp of
                 360dp, so the full title fits in both locales
                 (Roboto is a touch narrower than Noto, so there is
                 a little more room in practice).
                 No subtitle — title only, as asked. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/drawerButton"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/drawer_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_menu"
                    android:tint="@android:color/white" />

                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="none"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/toolbar_title_size"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:layout_marginEnd="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/toolbar_banner" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content column: everything between the app bar and the bottom
         nav. On wide screens MainActivity caps this column at
         @dimen/content_max_width (720dp) and centres it, so the list
         does not stretch uselessly on tablets; on phones it stays
         full width. -->
    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/content_margin"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="?attr/colorSurfaceVariant"
        app:boxCornerRadiusTopStart="28dp"
        app:boxCornerRadiusTopEnd="28dp"
        app:boxCornerRadiusBottomStart="28dp"
        app:boxCornerRadiusBottomEnd="28dp"
        app:hintEnabled="false"
        app:startIconDrawable="@android:drawable/ic_menu_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="8dp"
            android:paddingEnd="16dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Featured hero -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/featuredCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/content_margin"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/featuredBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/featured_label"
                android:textColor="@color/gohar_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <!-- Real icon on top of the gradient letter tile. -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <TextView
                    android:id="@+id/featuredIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/featuredIconImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/featuredName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/featuredTagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#DCE8F5"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/featuredMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#AEC6DE"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/featuredButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/hero_button_height"
                    android:layout_weight="1"
                    android:text="@string/install"
                    android:textSize="13sp"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="24dp"
                    android:textColor="@color/gohar_navy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/featuredDetailsButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/hero_button_height"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/view_details"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    app:cornerRadius="24dp"
                    app:strokeColor="@android:color/white" />

            </LinearLayout>

        </LinearLayout>

        <!-- Dismiss: hides the hero until "Show featured app" in the menu. -->
        <ImageButton
            android:id="@+id/featuredDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/dismiss_featured"
            android:src="@drawable/ic_close"
            android:tint="@android:color/white" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Category chips -->
    <HorizontalScrollView
        android:id="@+id/chipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/chip_row_padding"
            android:paddingEnd="@dimen/chip_row_padding"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginTop="16dp"
        android:text="@string/all_apps"
        android:textSize="@dimen/section_title_size"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Real loading state: a spinner + text while the catalogue
             first loads, instead of a blank list. The swipe spinner
             alone used to be the only sign anything was happening. -->
        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/gohar_teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/loading_catalogue"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/no_apps_search"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_margin"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/sourceNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/loading_catalogue"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_for_updates" />

    </LinearLayout>

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />

</LinearLayout>

    <!-- Side drawer: navy header (banner + name + version), teal
         icons, navy text; opens from the start side (left in English,
         right in Urdu). -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/gohar_card"
        app:headerLayout="@layout/nav_header_main"
        app:itemBackground="@drawable/drawer_item_background"
        app:itemIconTint="@color/gohar_teal"
        app:itemTextColor="@color/drawer_item_text"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
