<?xml version="1.0" encoding="utf-8"?>
<!-- Custom toast layout (C-44 / D-5.2): 12dp corners, an icon disc +
     a message. All colours are set in code by ToastHelper from the
     theme attributes (success / error / info variants) — nothing
     here hardcodes a colour, so the toast follows both themes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toastRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/toastIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/toastMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="14sp" />

</LinearLayout>
