<?xml version="1.0" encoding="utf-8"?>
<!-- Side-drawer header (v1.3.11): navy like the app bar, the store
     banner artwork large, name + subtitle + version, a gold rule.
     The version text is set in code (MainActivity) from
     BuildConfig.VERSION_NAME. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gohar_navy"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <ImageView
        android:layout_width="180dp"
        android:layout_height="68dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/toolbar_banner" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/drawer_subtitle"
        android:textColor="#C7D6E8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/navVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/gohar_gold"
        android:textSize="12sp" />

    <View
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:background="@color/gohar_gold" />

</LinearLayout>
