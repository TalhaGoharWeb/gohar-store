<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/toolbar_background"
            app:title="@string/developer_console"
            app:titleTextColor="@color/toolbar_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Which token is in use + catalogue status (v1.3.11: a proper
         status card — soft teal with a gold accent strip — instead of
         the plain blue strip. Same TextView id and text. -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#D6F2F1"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/gohar_gold" />

            <TextView
                android:id="@+id/statusLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:textAppearance="@style/TextAppearance.GoharStore.BodyS"
                android:textColor="@color/gohar_text" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />

        <!-- First-load skeleton (C-52, Phase 5 §G1): four skeleton
             rows replace the old centred spinner. The "Loading
             catalogue…" text stays beneath them (BodyM, C-10, S-06).
             Shown while the console catalogue loads (remote or
             read-only fallback); hidden on success, error, or empty.
             The alpha pulse is driven from AdminActivity. -->
        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/item_skeleton_admin" />
            <include layout="@layout/item_skeleton_admin" />
            <include layout="@layout/item_skeleton_admin" />
            <include layout="@layout/item_skeleton_admin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="@string/loading_catalogue"
                android:textAppearance="@style/TextAppearance.GoharStore.BodyM" />

        </LinearLayout>

        <!-- Shown when the GitHub load fails. -->
        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/admin_load_error"
                android:textAppearance="@style/TextAppearance.GoharStore.BodyM" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:textAppearance="@style/TextAppearance.GoharStore.LabelL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/admin_retry"
                app:backgroundTint="@color/gohar_teal"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/useCurrentButton"
                android:textAppearance="@style/TextAppearance.GoharStore.LabelL"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/admin_use_current"
                app:cornerRadius="20dp" />

        </LinearLayout>

        <!-- Empty-state mark (C-16): theme-aware logo mark (120dp, 40%
             opacity) above the empty-state text. The mark starts gone;
             its visibility must be toggled with emptyState by the
             Kotlin worker (empty-state handling) — layout only here. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/emptyStateMark"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:alpha="0.4"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_mark"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/no_apps_search"
                android:textAppearance="@style/TextAppearance.GoharStore.BodyM"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Add app FAB (C-53, Phase 7 §A10): REPLACES the old
             full-width "Add app" button at the bottom (I-4.0.18) —
             one control for the action, not two. 56dp, M3 default
             16dp corners, elevation 6dp (L3), primary-container fill
             + on-primary-container icon. Bottom-end, 16dp margins.
             The list's 88dp bottom padding clears it (see recycler
             paddingBottom): 56dp FAB + 16dp margin + 16dp gap. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/admin_add_app"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_add"
            app:tint="?attr/colorOnPrimaryContainer" />

    </FrameLayout>

</LinearLayout>
