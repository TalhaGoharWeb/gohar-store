<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets the store check whether *Talha's own* apps are installed, so
         it can show Install / Update / Open correctly. No other packages
         are queried. -->
    <queries>
        <package android:name="app.privatex.browser" />
        <package android:name="app.privacyx.privacy_x" />
        <package android:name="com.talhagohar.nigaarish" />
        <package android:name="com.hijaziapps.maliki_fiqh_user" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoharStore">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:label="App details"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ScreenshotViewerActivity"
            android:exported="false"
            android:label="Screenshots" />

        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:label="@string/developer_console"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AdminEditActivity"
            android:exported="false"
            android:label="@string/admin_new_app"
            android:parentActivityName=".AdminActivity" />

        <activity
            android:name=".AuthActivity"
            android:exported="false"
            android:label="@string/owner_sign_in"
            android:parentActivityName=".MainActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.gohar.store.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
